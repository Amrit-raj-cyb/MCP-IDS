# Copy to .env and adjust. NEVER put real credentials in this project.
LOG_LEVEL=INFO
# Sandbox for the filesystem MCP server (relative to project root, or absolute)
MCP_FS_SANDBOX=sandbox
# Set per session by the orchestrator (Phase 5); shown here for documentation only
# MCP_SESSION_ID=
# --- Agent brain (Phase 2) ---
# mock   = deterministic, seeded, offline, free (default; used for the dataset)
# claude = real model via the Anthropic API (needs credentials + internet)
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (cost/quality trade-off)
LLM_EFFORT=medium
# Credentials: set ANTHROPIC_API_KEY in your shell, or run `ant auth login`.
# Never commit a real key. Placeholder only:
# ANTHROPIC_API_KEY=placeholder-not-a-real-key
